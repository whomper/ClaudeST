class Pdf(Gateway):
    """pdfgate: PDFs converted for EConvert and EPDF by aerapdf, EPDF's
    converter, built here from this copy's pdf/ (EPDF's source at the
    commit in pdf/EPDF, tools/sync-pdf.sh)"""
    key, name, script = "pdf", "pdfgate", "pdfgate.py"
    title = "PDF converter for EConvert and EPDF on the Atari"
    removed = "pdfgate removed."
    PDF_SRC = os.path.join(os.path.dirname(HERE), "pdf")
    PDF_DIR = "/opt/aera-gateway-pdf"
    built = None                            # this install's aerapdf, built in prepare() ("kept": as it is)
    source = None                           # the sum of the pdf/ it is built from

    def options(self, ap):
        super().options(ap)
        ap.add_argument("--port", type=int, help="the port on the Pi (8380 is the default)")
        ap.add_argument("-v", "--verbose", action="store_true", default=None, help="log every request")
        ap.add_argument("--no-verbose", dest="verbose", action="store_false")

    def apply(self, ns, o):
        super().apply(ns, o)
        if o.port is not None:
            ns.port = o.port
        if o.verbose is not None:
            ns.verbose = o.verbose

    def check(self, ns):
        if not os.path.isdir(os.path.join(self.PDF_SRC, "epdf")):
            raise Failed("This copy has no pdf/ (EPDF's converter): install pdf from AERA-Gateway itself.")

    def pdf_sum(self):
        """a sum of this copy's pdf/: the same sum, the same aerapdf"""
        h = hashlib.sha256()
        for top, dirs, files in sorted(os.walk(self.PDF_SRC)):
            dirs[:] = sorted(d for d in dirs if d != "build")
            for f in sorted(files):
                if f != "aerapdf":
                    path = os.path.join(top, f)
                    h.update(os.path.relpath(path, self.PDF_SRC).encode() + b"\0")
                    with open(path, "rb") as fh:
                        h.update(fh.read())
        return h.hexdigest()

    def prepare(self, pi, ns):
        """aerapdf built from pdf/, unless the one there is from the same pdf/"""
        self.built = None
        self.source = self.pdf_sum()
        if pi.exists(self.PDF_DIR + "/aerapdf") and \
                (pi.read(self.PDF_DIR + "/BUILT") or "").strip() == self.source:
            self.built = "kept"
            return
        need = [pkg for prog, pkg in (("cc", "gcc"), ("make", "make")) if not pi.which(prog)]
        if need:
            heading("Installing %s, to build aerapdf (EPDF's converter)" % " and ".join(need))
            pi.run("apt-get", "update", "-qq")
            pi.run("apt-get", "install", "-y", "-qq", *need)
        heading("Building aerapdf: this takes a few minutes on a Pi")
        tmp = tempfile.mkdtemp(prefix="aerapdf-")
        shutil.copytree(self.PDF_SRC, os.path.join(tmp, "pdf"), ignore=shutil.ignore_patterns("aerapdf", "build"))
        if pi.run("make", "-s", "-C", os.path.join(tmp, "pdf"), check=False).returncode != 0 or \
                not os.path.isfile(os.path.join(tmp, "pdf", "aerapdf")):
            shutil.rmtree(tmp, ignore_errors=True)
            raise Failed("aerapdf didn't build (see above): pdfgate isn't installed.")
        self.built = tmp

    def before_start(self, pi):
        """aerapdf, its fonts and which EPDF it is from, in place before
        pdfgate starts; translategate's socket open to it (aerapdf's
        translator)"""
        join_translate(pi, self.name)
        if not self.built or self.built == "kept":
            self.built = None
            return
        try:
            pdf = os.path.join(self.built, "pdf")
            pi.rmtree(self.PDF_DIR + "/fonts")
            pi.makedirs(self.PDF_DIR + "/fonts")
            pi.copy(os.path.join(pdf, "aerapdf"), self.PDF_DIR + "/aerapdf", 0o755)
            for f in sorted(glob.glob(os.path.join(pdf, "epdf", "third_party", "liberation", "fonts", "*.ttf"))):
                pi.copy(f, "%s/fonts/%s" % (self.PDF_DIR, os.path.basename(f)), 0o644)
            with open(os.path.join(pdf, "EPDF")) as fh:
                pi.write(self.PDF_DIR + "/SOURCE", fh.read().strip() + "\n")
            pi.write(self.PDF_DIR + "/BUILT", self.source + "\n")
        finally:
            shutil.rmtree(self.built, ignore_errors=True)
            self.built = None

    def after_remove(self, pi):
        pi.rmtree(self.PDF_DIR)

    def args(self, ns):
        out = ["--port", str(ns.port)] + super().args(ns)
        out += self.kept(ns, "aerapdf", "fonts", "source", "max_mb", "time", "memory_mb", "jobs", "tmp",
                         "translator")
        out += ["-v"] if ns.verbose else []
        return out + ns.extra

    def ports(self, ns):
        return [str(ns.port)]

    def tell(self, ns, ip):
        return "\n".join([
            "",
            "pdfgate is running. In EConvert and EPDF on the Atari, Gateway mode, Through the Gateway:",
            "   Gateway:     %s" % ip,
            "   Port:        %s" % ns.port,
            "",
            "Check it from any browser on your network: http://%s:%s/version" % (ip, ns.port)])


class Translate(Gateway):
    """translategate: text translated on the Pi for the Atari apps, by a
    local engine (no text leaves the home network). The engine, Argos
    Translate's models run by CTranslate2, is in a venv of its own under
    /opt/translategate with its models, downloaded once here and offline
    after (Erez, 7 Nov 2026); "stand-in" needs nothing (CI)."""
    key, name, script = "translate", "translategate", "translategate.py"
    title = "Translation for the Atari apps (a local engine, nothing leaves the home network)"
    removed = "translategate removed."
    DIR = "/opt/translategate"
    VENV = DIR + "/venv"
    MODELS = DIR + "/models"
    INDEX = "https://raw.githubusercontent.com/argosopentech/argospm-index/main/index.json"
    LANGUAGES = "en,de"                     # the default (Erez, 7 Nov 2026)
    PIP = ("ctranslate2>=4,<5", "sentencepiece>=0.2,<0.3")
    MAX_MEMORY = 1536                       # MB translategate may take (MemoryMax) on a 4 GB Pi
    MIN_MEMORY = 3500                       # MB: the models loaded beside the other gateways (a 4 GB Pi
                                            # says about 3790)

    def options(self, ap):
        super().options(ap)
        ap.add_argument("--port", type=int, help="the port on the Pi (8480 is the default)")
        ap.add_argument("--engine", choices=("argos", "stand-in"),
                        help="argos (the default): Argos Translate's models; stand-in: no engine, for tests")
        ap.add_argument("--languages", metavar="CODES",
                        help="the languages to have, e.g. en,de (the default), en,de,he: exactly these (others "
                             "removed), each one to and from English, the others through English; each takes "
                             "120-300 MB loaded, 1108 MB of them at most")
        ap.add_argument("-v", "--verbose", action="store_true", default=None, help="log every request")
        ap.add_argument("--no-verbose", dest="verbose", action="store_false")

    def take_over(self, pi, ns):
        ns.engine = "argos"

    def apply(self, ns, o):
        super().apply(ns, o)
        if o.port is not None:
            ns.port = o.port
        if o.engine is not None:
            ns.engine = o.engine
        if o.verbose is not None:
            ns.verbose = o.verbose
        self.languages = None
        if o.languages is not None:
            codes = [c.strip() for c in o.languages.split(",") if c.strip()]
            if len(codes) < 2 or not all(re.fullmatch(r"[a-z]{2,3}", c) for c in codes):
                raise Usage("--languages: two or more codes, e.g. en,de")
            self.languages = codes

    def args(self, ns):
        out = ["--port", str(ns.port)] + super().args(ns)
        if ns.engine != ns.default["engine"]:
            out += ["--engine", ns.engine]
        out += self.kept(ns, "models", "state", "workers", "time")
        out += ["--local", self.LOCAL]          # for webgate and pdfgate (translateclient)
        out += ["-v"] if ns.verbose else []
        return out + [w for i, w in enumerate(ns.extra)
                      if w != "--local" and (i == 0 or ns.extra[i - 1] != "--local")]

    def ports(self, ns):
        return [str(ns.port)]

    def unit(self, ns, keep):
        text = super().unit(ns, keep)
        if ns.engine == "argos":
            text = text.replace("ExecStart=/usr/bin/python3 ", "ExecStart=%s/bin/python3 " % self.VENV)
        # the engine's memory (about 420 MB at its peak), beside the other
        # gateways on a 4 GB Pi; and when memory runs out, the kernel takes
        # a browser's page or a conversion before the loaded models
        # (the models may change from the Atari's Languages page, up to
        # translatelangs.CAP_MB of them: the most they may take, always)
        mm = "%dM" % self.MAX_MEMORY if ns.engine == "argos" else "1G"
        text = text.replace("Restart=always", "MemoryMax=%s\nOOMScoreAdjust=-300\nRestart=always" % mm, 1)
        # the languages' job's files (request, job), translategate's to write;
        # the local socket's folder, open to the group the gateways that
        # translate are in (aera-translate), and to no one else
        return text.replace("NoNewPrivileges=yes", "StateDirectory=translategate\nGroup=%s\n"
                            "RuntimeDirectory=translategate\nRuntimeDirectoryMode=0750\nNoNewPrivileges=yes"
                            % self.GROUP, 1)

    def describe(self, ns):
        return "engine " + ns.engine

    def prepare(self, pi, ns):
        """the engine: the memory for it (before anything changes), its venv
        and its models; kept as they are on an update"""
        if ns.engine != "argos":
            return
        arch = self.arch(pi)
        if not self.arch_ok(pi):
            raise Failed("translategate's engine needs a 64-bit system (CTranslate2 is made for aarch64 and "
                         "x86_64): uname -m says %s.\nOn a Raspberry Pi: the 64-bit Raspberry Pi OS." % arch)
        if not self.memory_ok(pi):
            raise Failed("translategate's engine needs a Pi with 4 GB of memory or more; this one has %d MB."
                         % self.memory(pi))
        venv = pi.path(self.VENV)
        if not pi.ok(venv + "/bin/python3", "-c", "import ctranslate2, sentencepiece"):
            heading("Setting up translategate's engine (CTranslate2, in %s)" % self.VENV)
            if not pi.ok("python3", "-c", "import venv, ensurepip"):
                pi.run("apt-get", "update", "-qq")
                pi.run("apt-get", "install", "-y", "-qq", "python3-venv", "python3-pip")
            pi.rmtree(self.VENV)
            pi.run("python3", "-m", "venv", venv)
            pi.run(venv + "/bin/pip", "install", "-q", *self.PIP)
        have = {os.path.basename(os.path.dirname(f))
                for f in glob.glob(pi.path(self.MODELS) + "/*/metadata.json")}
        want = self.languages or sorted({c for p in have for c in p.split("_")}) or self.LANGUAGES.split(",")
        # Argos's models go to and from English (a few others aside): a
        # pair through English, he>en>de, is what translategate does for the rest
        missing = [p for x in sorted(set(want) - {"en"}) for p in ((x, "en"), ("en", x))
                   if "%s_%s" % p not in have]
        if missing:
            self.fetch(pi, missing)
        if self.languages:                  # exactly these: the others' models removed
            for d in have:
                if not set(d.split("_")) <= set(want) | {"en"}:
                    pi.rmtree("%s/%s" % (self.MODELS, d))
        # the models' room: what translatelangs (and the Languages page) allow
        tl = load(HERE, "translatelangs.py")
        need = tl.size_mb(want)
        if need > tl.CAP_MB:
            for a, b in missing:
                pi.rmtree("%s/%s_%s" % (self.MODELS, a, b))
            raise Failed("The translation models for %s take %d MB; %d MB fit beside the other gateways. "
                         "Name fewer languages (--languages en,de)." % (",".join(sorted(set(want) | {"en"})),
                                                                       need, tl.CAP_MB))

    def memory(self, pi):
        m = re.search(r"^MemTotal:\s+(\d+) kB", pi.read("/proc/meminfo") or "", re.M)
        return int(m.group(1)) // 1024 if m else None

    def arch(self, pi):
        return pi.out("uname", "-m").strip()

    def arch_ok(self, pi):
        return self.arch(pi) in ("", "aarch64", "arm64", "x86_64")

    def memory_ok(self, pi):
        mb = self.memory(pi)
        return mb is None or mb >= self.MIN_MEMORY

    def fetch(self, pi, pairs):
        """Argos Translate's models for pairs, from its index (once; offline after)"""
        heading("Downloading the translation models: %s" % ", ".join("%s>%s" % p for p in pairs))
        tl = load(HERE, "translatelangs.py")
        try:
            urls = tl.links(pairs)
            for p in sorted(urls):
                say("   %s>%s from %s" % (p[0], p[1], urls[p]))
                tl.fetch(p, urls[p], pi.path(self.MODELS))
        except tl.Fail as e:
            raise Failed(str(e))

    LOCAL = "/run/translategate/local.sock"
    GROUP = TRANSLATE_GROUP                 # the gateways that may use the local socket

    UNITS_LANGS = ("translategate-langs.path", "translategate-langs.service")

    def langs_units(self):
        """the languages' job: translategate writes a request, systemd runs
        translatelangs for it, as translategate's user, the only one of the
        two that connects anywhere (Argos Translate's downloads)"""
        path = "\n".join([
            "[Unit]", "Description=translategate's languages: a request from an app's Languages page", "",
            "[Path]", "PathModified=/var/lib/translategate/request", "Unit=translategate-langs.service", "",
            "[Install]", "WantedBy=multi-user.target", ""])
        svc = "\n".join([
            "[Unit]", "Description=translategate's languages: Argos Translate's models put in and taken out", "",
            "[Service]", "Type=oneshot", "User=translategate",
            "ExecStart=/usr/bin/python3 %s/translatelangs.py job" % OPT,
            "StateDirectory=translategate", "ReadWritePaths=%s" % self.MODELS,
            "TimeoutStartSec=3600", "MemoryMax=256M",
            "NoNewPrivileges=yes", "ProtectSystem=strict", "ProtectHome=yes", "PrivateTmp=yes",
            "RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX", ""])
        return {self.UNITS_LANGS[0]: path, self.UNITS_LANGS[1]: svc}

    def before_start(self, pi):
        """the models translategate's own (the Languages page changes them),
        the languages' job set up, and the local socket's group"""
        if not pi.ok("getent", "group", self.GROUP):
            pi.run("groupadd", "--system", self.GROUP)
        pi.makedirs(self.MODELS)
        pi.run("chown", "-R", "translategate:translategate", self.MODELS)
        for name, text in self.langs_units().items():
            pi.write("%s/%s" % (UNITS, name), text)
        pi.run("systemctl", "daemon-reload")
        pi.run("systemctl", "enable", "--now", self.UNITS_LANGS[0], out="hide")

    def after_remove(self, pi):
        pi.run("systemctl", "disable", "--now", *self.UNITS_LANGS, check=False, out="hide", errors=False)
        for name in self.UNITS_LANGS:
            pi.remove("%s/%s" % (UNITS, name))
        pi.run("systemctl", "daemon-reload")
        pi.rmtree(self.DIR)

    def tell(self, ns, ip):
        return "\n".join([
            "",
            "translategate is running%s. In the apps on the Atari, Translate:" % (
                "" if ns.engine == "argos" else " (engine: %s)" % ns.engine),
            "   Gateway:  %s" % ip,
            "   Port:     %s" % ns.port,
            "",
            "Check it from any browser on your network: http://%s:%s/status" % (ip, ns.port)])


