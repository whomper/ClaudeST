class Failed(Exception):
    """what went wrong, for the person at the Pi"""


class Usage(Failed):
    pass


# ---------------------------------------------------------------- the computer

class Pi:
    """The computer being set up: its commands and files. The tests give
    a stand-in with its files in a folder of their own."""

    def __init__(self, root="/"):
        self.root = root

    def path(self, p):
        return os.path.join(self.root, p.lstrip("/"))

    def run(self, *cmd, check=True, out="show", errors=True, input=None):
        """out: "show" it, "hide" it or "keep" it (returned)"""
        r = subprocess.run(cmd, input=input, universal_newlines=True,
                           stdout={"show": None, "hide": subprocess.DEVNULL, "keep": subprocess.PIPE}[out],
                           stderr=None if errors else subprocess.DEVNULL)
        if check and r.returncode:
            raise Failed("%s failed" % " ".join(cmd))
        return r

    def ok(self, *cmd):
        return self.run(*cmd, check=False, out="hide", errors=False).returncode == 0

    def out(self, *cmd):
        r = self.run(*cmd, check=False, out="keep", errors=False)
        return r.stdout if r.returncode == 0 else ""

    def have(self, prog):
        return shutil.which(prog) is not None

    def is_root(self):
        return os.geteuid() == 0

    def tty(self):
        return sys.stdin.isatty()

    def ask(self, prompt, secret=False):
        if not self.tty():
            return ""
        try:
            return (getpass.getpass(prompt) if secret else input(prompt)).strip()
        except EOFError:
            return ""

    def sleep(self, s):
        time.sleep(s)

    def exists(self, p):
        return os.path.lexists(self.path(p))

    def read(self, p):
        try:
            with open(self.path(p)) as f:
                return f.read()
        except OSError:
            return None

    def write(self, p, text, mode=0o644, owner=None):
        """the whole file at once: nobody sees half of it, and nobody but
        owner ("user:group") and mode let in sees any of it, even while
        it is being written (a settings file holds keys)"""
        full = self.path(p)
        os.makedirs(os.path.dirname(full), exist_ok=True)
        tmp = full + ".aera-new"
        with contextlib.suppress(FileNotFoundError):
            os.remove(tmp)          # one left over keeps its own mode and owner
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), mode & 0o600)
        with os.fdopen(fd, "w") as f:
            if owner:
                self.own(fd, p, owner)
            os.fchmod(fd, mode)     # the umask doesn't decide
            f.write(text)
        os.replace(tmp, full)

    def own(self, fd, p, owner):
        """the open file fd (for p) to owner, "user:group" """
        user, _, group = owner.partition(":")
        os.fchown(fd, pwd.getpwnam(user).pw_uid, grp.getgrnam(group).gr_gid if group else -1)

    def copy(self, src, p, mode=None):
        """src to p; without a mode, src's as cp gives it"""
        if mode is None:
            mode = os.stat(src).st_mode & 0o755
        with open(src) as f:
            self.write(p, f.read(), mode)

    def makedirs(self, p):
        os.makedirs(self.path(p), exist_ok=True)

    def rename(self, a, b):
        os.rename(self.path(a), self.path(b))

    def remove(self, p):
        with contextlib.suppress(FileNotFoundError):
            os.remove(self.path(p))

    def rmtree(self, p):
        shutil.rmtree(self.path(p), ignore_errors=True)

    def ip(self):
        words = self.out("hostname", "-I").split()
        return words[0] if words else ""


def say(*lines):
    for line in lines:
        print(line)
    sys.stdout.flush()


def heading(text):
    say("", "== " + text)


# ---------------------------------------------------------------- services and units

def unit_path(name):
    return "%s/%s.service" % (UNITS, name)


def unit_word(w):
    """one argument on an ExecStart= line"""
    w = w.replace("%", "%%").replace("$", "$$")
    if not w or re.search(r"[\s\"'\\;]", w):
        w = '"' + w.replace("\\", "\\\\").replace('"', '\\"') + '"'
    return w


def exec_args(unit, script):
    """(the path, the arguments) of script on the unit's ExecStart= line,
    or (None, None) when it doesn't run script"""
    for line in unit.splitlines():
        if line.startswith("ExecStart="):
            try:
                words = shlex.split(line[len("ExecStart="):].lstrip("-@:+!"))
            except ValueError:
                return None, None
            words = [w.replace("%%", "%").replace("$$", "$") for w in words]
            for i, w in enumerate(words):
                if os.path.basename(w) == script:
                    return w, words[i + 1:]
    return None, None


def carried(unit):
    """lines of an old unit to keep: Environment= (HTTPS_PROXY, say)"""
    return [line for line in (unit or "").splitlines()
            if line.startswith(("Environment=", "EnvironmentFile="))]


def listening(pi, port):
    return "LISTEN" in pi.out("ss", "-ltn", "( sport = :%s )" % port)


def up(pi, name, ports, wait=10):
    """Is the service running, and listening on all its ports, twice in a row?"""
    steady = 0
    for _ in range(wait * 2):
        pi.sleep(0.5)
        if pi.ok("systemctl", "is-active", "--quiet", name) and all(listening(pi, p) for p in ports):
            steady += 1
            if steady == 2:
                return True
        else:
            steady = 0
    return False


def firewall(pi, ports, allow):
    """A firewall that is on must let the Atari in, or it can't connect;
    if a rule can't be added, say so and stop."""
    if not pi.have("ufw") or not re.search(r"^Status: active", pi.out("ufw", "status"), re.M):
        return
    for p in ports:
        for who in allow or HOME_NETS:
            if not pi.ok("ufw", "allow", "from", who, "to", "any", "port", str(p), "proto", "tcp"):
                raise Failed("Couldn't let %s in on port %s with ufw: stopping. The gateway runs, but the\n"
                             "firewall may keep the Atari out; add the rule by hand:\n"
                             "   sudo ufw allow from %s to any port %s proto tcp" % (who, p, who, p))


def allow_list(values):
    """--allow as given: repeated or with commas; "any" means the home network"""
    out = []
    for v in values:
        for a in v.split(","):
            a = a.strip()
            if a == "any":
                return []
            if a:
                out.append(a)
    return out


# ---------------------------------------------------------------- the gateways

def load(src, script):
    """a gateway's code from src, for its parser()"""
    if src not in sys.path:
        sys.path.insert(0, src)
    spec = importlib.util.spec_from_file_location(script[:-3], os.path.join(src, script))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


class Gateway:
    """emailgate, ecalgate or eftpgate: a script in OPT run as a service
    by a user of its own"""
    key = name = script = title = ""
    packages = ()               # Debian packages beyond python3 and ca-certificates
    state = False               # a StateDirectory (eftpgate's SSH host keys)
    removed = ""

    def unit_file(self):
        return unit_path(self.name)

    def installed(self, pi):
        return pi.exists(self.unit_file())

    def parse(self, src, args):
        """the gateway's settings from its command line"""
        ap = load(src, self.script).parser()
        try:
            with contextlib.redirect_stderr(io.StringIO()):
                ns, extra = ap.parse_known_args(args)
        except SystemExit:
            raise Failed("can't read %s's settings in %s (%s)" % (self.name, self.unit_file(), " ".join(args)))
        ns.extra = extra
        ns.default = {a.dest: a.default for a in ap._actions}
        return ns

    def current(self, pi, src):
        """(settings, the unit's text, the script it runs) as installed now,
        or (None, None, None)"""
        text = pi.read(self.unit_file())
        if text is None:
            return None, None, None
        script, args = exec_args(text, self.script)
        if script is None:
            raise Failed("%s doesn't run %s: not touching it" % (self.unit_file(), self.script))
        return self.parse(src, args), text, script

    def options(self, ap):
        ap.add_argument("--allow", action="append", metavar="ATARI_IP",
                        help="only the Atari at this address may use it (more: repeat, or IP1,IP2; "
                             "'any' for the whole home network again)")
        ap.add_argument("--remove", action="store_true", help=argparse.SUPPRESS)

    def apply(self, ns, o):
        if o.allow is not None:
            ns.allow = allow_list(o.allow)

    def check(self, ns):
        pass

    def args(self, ns):
        out = []
        if ns.bind != ns.default["bind"]:
            out += ["--bind", ns.bind]
        for a in ns.allow or []:
            out += ["--allow", a]
        return out

    def ports(self, ns):
        """the ports it listens on"""
        return []

    def open_ports(self, ns):
        """the ports the firewall must open"""
        return self.ports(ns)

    def unit(self, ns, keep):
        low = any(int(p) < 1024 for p in self.ports(ns))
        lines = ["[Unit]",
                 "Description=" + self.title,
                 "After=network-online.target",
                 "Wants=network-online.target",
                 "",
                 "[Service]",
                 "User=" + self.name,
                 "ExecStart=/usr/bin/python3 %s/%s %s" % (OPT, self.script,
                                                         " ".join(unit_word(w) for w in self.args(ns)))]
        lines += keep
        if self.state:
            lines.append("StateDirectory=" + self.name)
        lines += ["Restart=always", "RestartSec=5"]
        if low:
            lines += ["# ports below 1024: that one privilege, and no other",
                      "AmbientCapabilities=CAP_NET_BIND_SERVICE",
                      "CapabilityBoundingSet=CAP_NET_BIND_SERVICE"]
        lines += ["NoNewPrivileges=yes", "ProtectSystem=strict", "ProtectHome=yes", "PrivateTmp=yes",
                  "", "[Install]", "WantedBy=multi-user.target", ""]
        return "\n".join(lines)

    def tell(self, ns, ip):
        return ""

    def describe(self, ns):
        return ""

    def before_start(self, pi):
        pass

    def started(self, pi):
        pass

    def not_started(self, pi):
        pass

    def after_remove(self, pi):
        pass


class Mail(Gateway):
    key, name, script = "mail", "emailgate", "emailgate.py"
    title = "EMail gateway for the Atari (TLS to the mail provider)"
    removed = "emailgate removed."
    STUNNEL = "/etc/stunnel/atari-mail.conf"

    def options(self, ap):
        ap.add_argument("servers", nargs="*", metavar="SERVER",
                        help="IMAP_SERVER SMTP_SERVER[:587] [POP3_SERVER]: your provider's (needed the first time)")
        super().options(ap)
        ap.add_argument("--ports", metavar="IMAP,SMTP,POP3",
                        help="the ports on the Pi when the usual ones (143,587,110) are taken")

    def apply(self, ns, o):
        super().apply(ns, o)
        if o.servers:
            if len(o.servers) not in (2, 3):
                raise Usage("name the IMAP and SMTP servers, and the POP3 server if you want it")
            ns.imap, ns.smtp = o.servers[:2]
            ns.pop3 = o.servers[2] if len(o.servers) == 3 else None
        if o.ports:
            p = o.ports.split(",")
            if not 2 <= len(p) <= 3 or not all(x.isdigit() for x in p):
                raise Usage("--ports wants three port numbers: IMAP,SMTP,POP3 (e.g. 2143,2587,2110)")
            ns.ports = ",".join(p + ["110"][:3 - len(p)])

    def check(self, ns):
        if not ns.imap or not ns.smtp:
            raise Usage("name your provider's servers: aera-gateway install mail IMAP_SERVER SMTP_SERVER[:587] "
                        "[POP3_SERVER]\n(e.g. imap.gmail.com smtp.gmail.com pop.gmail.com)")

    def args(self, ns):
        out = ["-v", "--ports", ns.ports] + super().args(ns) + ns.extra + [ns.imap, ns.smtp]
        return out + ([ns.pop3] if ns.pop3 else [])

    def ports(self, ns):
        p = (ns.ports.split(",") + ["110", "110"])[:3]
        return p if ns.pop3 else p[:2]

    def describe(self, ns):
        return "%s %s%s" % (ns.imap, ns.smtp, " " + ns.pop3 if ns.pop3 else "")

    def tell(self, ns, ip):
        imap, smtp, pop3 = (ns.ports.split(",") + ["110", "110"])[:3]
        lines = ["",
                 "The gateway is running%s. In EMail's account dialog (Options > Accounts):" % (
                     " for %s only" % ", ".join(ns.allow) if ns.allow else ""),
                 "",
                 "  Incoming:  IMAP   Server: %s   Port: %s" % (ip, imap)]
        if ns.pop3:
            lines.append("  (or POP3        Server: %s   Port: %s)" % (ip, pop3))
        lines += ["  Outgoing (SMTP)   Server: %s   Port: %s" % (ip, smtp),
                  "",
                  "with your usual mail user name and password (for Gmail: an app password)."]
        return "\n".join(lines)

    def before_start(self, pi):
        """EMail 1.x's stunnel set-up stopped and put aside, so that
        emailgate gets its ports; it comes back if emailgate doesn't start"""
        if not pi.exists(self.STUNNEL):
            return
        # while its .conf is still there: Debian's stunnel4 finds what to
        # stop by the pid files the .conf files name
        pi.run("systemctl", "stop", "stunnel4", check=False, out="hide", errors=False)
        for line in (pi.read(self.STUNNEL) or "").splitlines():
            key, _, value = line.partition("=")
            if key.strip() == "pid":
                pid = (pi.read(value.strip()) or "").strip()
                if pid.isdigit():
                    pi.run("kill", pid, check=False, out="hide", errors=False)
        pi.rename(self.STUNNEL, self.STUNNEL + ".aera-old")
        if glob.glob(pi.path("/etc/stunnel/*.conf")):
            pi.run("systemctl", "start", "stunnel4", check=False, errors=False)

    def started(self, pi):
        if not pi.exists(self.STUNNEL + ".aera-old"):
            return
        pi.remove(self.STUNNEL + ".aera-old")
        if glob.glob(pi.path("/etc/stunnel/*.conf")):
            say("Removed EMail's old stunnel set-up (%s); stunnel keeps running for the others." % self.STUNNEL)
        else:
            pi.run("systemctl", "disable", "--now", "stunnel4", check=False, out="hide", errors=False)
            say("Removed EMail's old stunnel set-up (%s) and stopped stunnel." % self.STUNNEL)

    def not_started(self, pi):
        if not pi.exists(self.STUNNEL + ".aera-old"):
            return
        pi.rename(self.STUNNEL + ".aera-old", self.STUNNEL)
        pi.run("systemctl", "restart", "stunnel4", check=False, errors=False)
        say("EMail's old stunnel set-up (%s) is back." % self.STUNNEL)

    def after_remove(self, pi):
        self.before_start(pi)
        self.started(pi)


class Dav(Gateway):
    key, name, script = "dav", "ecalgate", "ecalgate.py"
    title = "ECal and EContact gateway for the Atari (HTTPS for CalDAV, CardDAV and subscriptions)"
    removed = "ecalgate removed."

    def options(self, ap):
        super().options(ap)
        ap.add_argument("--port", type=int, help="the port on the Pi (8180 is the default)")
        ap.add_argument("--allow-local", action="store_true", default=None,
                        help="also reach servers on the home network (a Radicale or Nextcloud at home)")
        ap.add_argument("--no-allow-local", dest="allow_local", action="store_false")
        ap.add_argument("-v", "--verbose", action="store_true", default=None,
                        help="log every request (the server, never the address's path)")
        ap.add_argument("--no-verbose", dest="verbose", action="store_false")

    def apply(self, ns, o):
        super().apply(ns, o)
        if o.port is not None:
            ns.port = o.port
        if o.allow_local is not None:
            ns.allow_local = o.allow_local
        if o.verbose is not None:
            ns.verbose = o.verbose

    def args(self, ns):
        out = ["--port", str(ns.port)] + super().args(ns)
        out += ["--allow-local"] if ns.allow_local else []
        out += ["--insecure"] if ns.insecure else []
        out += ["-v"] if ns.verbose else []
        return out + ns.extra

    def ports(self, ns):
        return [str(ns.port)]

    def describe(self, ns):
        return "servers at home %s" % ("allowed" if ns.allow_local else "refused")

    def tell(self, ns, ip):
        return "\n".join([
            "",
            "ecalgate is running. In ECal and EContact on the Atari, Settings > Connection:",
            "   Pi gateway:  %s" % ip,
            "   Port:        %s" % ns.port,
            "",
            "Check it from any browser on your network: http://%s:%s/" % (ip, ns.port)])


class Ftp(Gateway):
    key, name, script = "ftp", "eftpgate", "eftpgate.py"
    title = "EFTP gateway for the Atari (FTPS and SFTP)"
    packages = ("python3-paramiko",)
    state = True
    removed = "eftpgate removed (the SSH keys it remembered stay in /var/lib/eftpgate)."
    PASV = "30000-30099"            # the data connections' ports

    def options(self, ap):
        super().options(ap)
        ap.add_argument("--port", type=int, help="the port on the Pi (2121 is the default)")
        ap.add_argument("--allow-local", action="store_true", default=None,
                        help="also reach servers on the home network (a NAS)")
        ap.add_argument("--no-allow-local", dest="allow_local", action="store_false")
        ap.add_argument("--cafile", metavar="CA.PEM",
                        help="check FTPS servers against this CA instead of the Pi's roots (a NAS's own)")
        ap.add_argument("--no-cafile", dest="cafile", action="store_const", const="")
        ap.add_argument("-v", "--verbose", action="store_true", default=None,
                        help="log every command (never the passwords)")
        ap.add_argument("--no-verbose", dest="verbose", action="store_false")

    def parse(self, src, args):
        ns = super().parse(src, args)
        ns.verbose = ns.v
        return ns

    def apply(self, ns, o):
        super().apply(ns, o)
        if o.port is not None:
            ns.port = o.port
        if o.allow_local is not None:
            ns.allow_local = o.allow_local
        if o.cafile is not None:
            if o.cafile and not os.path.isfile(o.cafile):
                raise Usage("--cafile: there is no %s" % o.cafile)
            ns.cafile = os.path.abspath(o.cafile) if o.cafile else None
        if o.verbose is not None:
            ns.verbose = o.verbose

    def args(self, ns):
        out = ["--port", str(ns.port), "--pasv-ports", ns.pasv_ports or self.PASV] + super().args(ns)
        out += ["--allow-local"] if ns.allow_local else []
        out += ["--cafile", ns.cafile] if ns.cafile else []
        out += ["--state", ns.state] if ns.state != "/var/lib/eftpgate" else []
        out += ["-v"] if ns.verbose else []
        return out + ns.extra

    def ports(self, ns):
        return [str(ns.port)]

    def open_ports(self, ns):
        return [str(ns.port), (ns.pasv_ports or self.PASV).replace("-", ":")]

    def describe(self, ns):
        return "servers at home %s%s" % ("allowed" if ns.allow_local else "refused",
                                         ", CA " + ns.cafile if ns.cafile else "")

    def tell(self, ns, ip):
        return "\n".join([
            "",
            "eftpgate is running. In EFTP on the Atari, Options > Settings > Secure:",
            "   Pi gateway:  %s" % ip,
            "   Port:        %s" % ns.port,
            "",
            "Then give your FTPS and SFTP sites their real server names in File > Sites."])


