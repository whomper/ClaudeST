def put_files(pi, src):
    """This copy's gateways to OPT, the old ones kept aside: returns
    (undo, done)."""
    new, old = OPT + ".new", OPT + ".old"
    pi.rmtree(new)
    pi.rmtree(old)
    pi.makedirs(new)
    for f in FILES:
        pi.copy(os.path.join(src, f), "%s/%s" % (new, f), 0o755 if f.endswith(".py") and f != "aeragate.py" else 0o644)
    pi.write("%s/VERSION" % new, VERSION + "\n")          # (what the dashboard shows)
    for f in sorted(glob.glob(os.path.join(src, EXT, "*"))):
        pi.copy(f, "%s/%s/%s" % (new, EXT, os.path.basename(f)), 0o644)
    had = pi.exists(OPT)
    if had:
        pi.rename(OPT, old)
    pi.rename(new, OPT)

    def undo():
        pi.rmtree(OPT)
        if had:
            pi.rename(old, OPT)

    def done():
        pi.rmtree(old)
    return undo, done


def need_packages(pi, gw):
    need = []
    if not pi.have("python3"):
        need.append("python3")
    if not pi.exists("/etc/ssl/certs/ca-certificates.crt"):     # the roots, for checking the servers
        need.append("ca-certificates")
    for package, module in (("python3-paramiko", "paramiko"), ("python3-pil", "PIL")):
        if package in gw.packages and not pi.ok("python3", "-c", "import " + module):
            need.append(package)
    if "ffmpeg" in gw.packages and not pi.which("ffmpeg"):
        need.append("ffmpeg")
    if need:
        if "ffmpeg" in need:
            heading("Installing ffmpeg, for the stations that don't send MP3")
        pi.run("apt-get", "update", "-qq")
        pi.run("apt-get", "install", "-y", "-qq", *need)


def install_gateway(pi, gw, o, src=HERE):
    ns, old_unit, old_script = gw.current(pi, src)
    if ns is None:
        ns = gw.parse(src, ["x", "y"] if gw.key == "mail" else [])
        if gw.key == "mail":
            ns.imap = ns.smtp = None
        gw.take_over(pi, ns)
    gw.apply(ns, o)
    gw.check(ns)
    gw.prepare(pi, ns)
    need_packages(pi, gw)
    if not pi.ok("id", gw.name):
        pi.run("useradd", "--system", "--no-create-home", *(["--home-dir", gw.home] if gw.home else []),
               "--shell", "/usr/sbin/nologin", gw.name)
    undo, done = put_files(pi, src)
    pi.write(gw.unit_file(), gw.unit(ns, carried(old_unit)))
    pi.run("systemctl", "daemon-reload")
    pi.run("systemctl", "enable", gw.name + ".service", out="hide")
    gw.before_start(pi)
    pi.run("systemctl", "restart", gw.name + ".service", check=False)
    if not up(pi, gw.name, gw.ports(ns)):
        # what was there before comes back
        undo()
        if old_unit is not None:
            pi.write(gw.unit_file(), old_unit)
            pi.run("systemctl", "daemon-reload")
            pi.run("systemctl", "restart", gw.name + ".service", check=False)
            old_ns = gw.parse(src, exec_args(old_unit, gw.script)[1])
            back = " The one before is running again." if up(pi, gw.name, gw.ports(old_ns)) else \
                " The one before didn't start again either."
        else:
            pi.run("systemctl", "disable", "--now", gw.name + ".service", check=False, out="hide", errors=False)
            pi.remove(gw.unit_file())
            pi.run("systemctl", "daemon-reload")
            back = ""
        busy = [p for p in gw.ports(ns) if listening(pi, p)] if old_unit is None else []
        gw.not_started(pi)
        raise Failed("%s didn't start%s.%s See: sudo journalctl -u %s -n 30" % (
            gw.name, " (port %s is taken by another program)" % ", ".join(busy) if busy else "", back, gw.name))
    done()
    gw.started(pi, ns)
    if old_script and os.path.dirname(old_script) != OPT:
        pi.remove(old_script)           # the app's own copy: this one answers now
    firewall(pi, gw.open_ports(ns), ns.allow)
    say(gw.tell(ns, pi.ip() or "GATEWAY_IP"))


def remove_gateway(pi, gw):
    pi.run("systemctl", "disable", "--now", gw.name + ".service", check=False, out="hide", errors=False)
    old_script, _ = exec_args(pi.read(gw.unit_file()) or "", gw.script)
    pi.remove(gw.unit_file())
    pi.run("systemctl", "daemon-reload")
    if old_script and os.path.dirname(old_script) != OPT:
        pi.remove(old_script)
    gw.after_remove(pi)
    if not any(g.installed(pi) for g in GATEWAYS):
        pi.rmtree(OPT)
    say(gw.removed)


# ---------------------------------------------------------------- ClaudeST's bridge

class Claude:
    """ClaudeST's bridge, from this copy's claude-st/ (moved here from
    ClaudeST, Erez 9 Nov 2026; ClaudeST owns its protocol and reviews its
    changes), or with --from from a ClaudeST copy with bridge/ and pi/:
    set up as ClaudeST's pi/install.sh did"""
    key, name = "claude", "claude-st"
    BRIDGE_SRC = os.path.join(HERE, "claude-st")
    PREFIX = "/opt/claude-st"
    CONF_DIR = "/etc/claude-st"
    CONF = "/etc/claude-st/claude-st.env"
    DEFAULT_CONF = """\
# ClaudeST gateway settings. After editing: sudo systemctl restart claude-st
# Bridge options, see: claude_bridge.py --help
CLAUDE_ST_ARGS=--backend claudeai --tcp 0.0.0.0:2323
# claude.ai "sessionKey" cookie (for --backend claudeai). Change it with:
#   sudo gateway/aera-gateway set-key   (in the AERA-Gateway folder)
CLAUDE_SESSION_KEY=
# Anthropic API key (for --backend api)
#ANTHROPIC_API_KEY=
"""

    def unit_file(self):
        return unit_path(self.name)

    def installed(self, pi):
        return pi.exists(self.unit_file())

    def options(self, ap):
        ap.add_argument("--from", dest="source", metavar="DIR",
                        help="a ClaudeST copy (bridge/ and pi/) to take the bridge from (default: this "
                             "AERA-Gateway's own)")
        ap.add_argument("--tag", help=argparse.SUPPRESS)
        ap.add_argument("--backend", help="claudeai (default), api or demo")
        ap.add_argument("--network", action="store_const", const="tcp", dest="mode",
                        help="network: ClaudeST connects over STinG (Ethernet or WiFi)")
        ap.add_argument("--atari", metavar="ATARI_IP",
                        help="the Atari's address (several: IP1,IP2; any address on the home network: any)")
        ap.add_argument("--listen-port", dest="tcp_port", help="the port for the Atari (2323 is the default)")
        # (the serial cable went with ClaudeST 2.3, Erez 9 Nov 2026: refused, saying so)
        ap.add_argument("--serial", "--port", dest="port", help=argparse.SUPPRESS)
        ap.add_argument("--baud", help=argparse.SUPPRESS)
        ap.add_argument("--set-key", action="store_true", help="paste a new claude.ai session key")
        ap.add_argument("--uninstall", "--remove", action="store_true", dest="remove", help=argparse.SUPPRESS)

    # the settings file, as pi/install.sh kept it
    def get_var(self, pi, name):
        found = [line[len(name) + 1:] for line in (pi.read(self.CONF) or "").splitlines()
                 if line.startswith(name + "=")]
        return found[-1] if found else ""

    def set_var(self, pi, name, value):
        """NAME=VALUE in the settings file, in place of any earlier NAME= line"""
        lines = [line for line in (pi.read(self.CONF) or "").splitlines() if not line.startswith(name + "=")]
        pi.write(self.CONF, "".join(line + "\n" for line in lines) + "%s=%s\n" % (name, value), 0o640,
                 "root:claude-st")

    SERIAL_GONE = ("ClaudeST's serial cable isn't supported any more (ClaudeST 2.3, the Gateway %s): "
                   "ClaudeST reaches the Gateway through STinG. To move to the network: "
                   "sudo aera-gateway install claude --network --atari ATARI_IP")

    def on_cable(self, pi):
        """is it set up for the serial cable (before ClaudeST 2.3)?"""
        return self.installed(pi) and "--serial" in self.get_var(pi, "CLAUDE_ST_ARGS")

    def settings(self, pi, o):
        """what to set up: the options given, and for the rest what the
        settings file says now (or the defaults)"""
        args = self.get_var(pi, "CLAUDE_ST_ARGS")

        def found(pattern):
            m = re.match(pattern, args)
            return m.group(1) if m else ""
        cur_backend = found(r".*--backend ([a-z]*)")
        cur_tcp = found(r".*--tcp [^ ]*:([0-9]*)")
        cur_atari = ",".join(re.findall(r"--allow ([^ ]*)", args))
        if not cur_atari and cur_tcp:
            cur_atari = "any"
        if o.port or o.baud:
            raise Usage(self.SERIAL_GONE % VERSION)
        if not cur_tcp and not (o.mode or o.atari or o.tcp_port) and self.on_cable(pi):
            # (an install without --network keeps the cable it has: the update's words)
            raise Failed(self.SERIAL_GONE % VERSION)
        s = argparse.Namespace(
            backend=o.backend or cur_backend or "claudeai", mode="tcp",
            tcp_port=o.tcp_port or cur_tcp or "2323", atari=o.atari or cur_atari)
        if s.backend not in ("claudeai", "api", "demo"):
            raise Usage("backend must be claudeai, api or demo")
        if not s.atari:
            s.atari = pi.ask("The Atari's IP address (several: IP1,IP2; or 'any'): ")
        if not s.atari:
            raise Usage("ClaudeST needs the Atari's IP address, e.g. --atari 192.168.1.20 (or --atari any)")
        if s.atari != "any":
            for ip in s.atari.replace(",", " ").split():
                if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+", ip):
                    raise Usage("--atari wants IP addresses or 'any', not %s" % ip)
        return s

    def source(self, o):
        """(a folder with the bridge's bridge/, its unit file, what it is)"""
        if o.tag:
            raise Usage("--tag: the bridge comes with AERA-Gateway now (ClaudeST's releases no longer carry it); "
                        "an older one: --from a ClaudeST copy")
        if not o.source:
            d = self.BRIDGE_SRC
            if not os.path.isfile(os.path.join(d, "bridge", "claude_bridge.py")):
                raise Failed("This copy has no claude-st/ (ClaudeST's bridge): install claude from AERA-Gateway "
                             "itself, or --from a ClaudeST copy.")
            with open(os.path.join(d, "CLAUDEST")) as f:
                return d, os.path.join(d, "claude-st.service"), "AERA-Gateway %s (ClaudeST %s)" % (
                    VERSION, f.read().strip()[:12])
        if o.source:
            d = os.path.abspath(o.source)
            for f in ("bridge/claude_bridge.py", "bridge/requirements.txt", "pi/claude-st.service"):
                if not os.path.isfile(os.path.join(d, f)):
                    raise Failed("%s isn't a ClaudeST copy: there is no %s" % (d, f))
            # root reading a user's checkout: git would refuse it as "dubious ownership"
            try:
                rev = subprocess.run(["git", "-c", "safe.directory=*", "-C", d, "describe", "--tags", "--always",
                                      "--dirty"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                     universal_newlines=True).stdout.strip()
            except OSError:
                rev = ""
            return d, os.path.join(d, "pi", "claude-st.service"), \
                "ClaudeST %sfrom %s" % (rev + " " if rev else "", d)

    def install(self, pi, o):
        if o.remove:
            return self.remove(pi)
        if o.set_key:
            return self.set_key(pi)
        s = self.settings(pi, o)
        src, unit, what = self.source(o)
        self.set_up(pi, s, src, unit, what)

    def set_up(self, pi, s, src, unit, what):

        heading("Installing packages")
        pi.run("apt-get", "update", "-qq")
        pi.run("apt-get", "install", "-y", "-qq", "python3", "python3-venv", out="hide")

        heading("Creating the claude-st service user")
        if not pi.ok("id", "claude-st"):
            pi.run("useradd", "--system", "--home-dir", "/var/lib/claude-st", "--shell", "/usr/sbin/nologin",
                   "claude-st")

        heading("Copying the bridge to %s" % self.PREFIX)
        pi.makedirs(self.PREFIX + "/bridge")
        for f in sorted(glob.glob(os.path.join(src, "bridge", "*.py"))) + [os.path.join(src, "bridge",
                                                                                         "requirements.txt")]:
            if os.path.basename(f) != "test_bridge.py":
                pi.copy(f, "%s/bridge/%s" % (self.PREFIX, os.path.basename(f)))
        pi.remove(self.PREFIX + "/bridge/test_bridge.py")
        pi.write(self.PREFIX + "/SOURCE", what + "\n")

        heading("Setting up Python packages (this can take a few minutes on a Pi)")
        venv = pi.path(self.PREFIX + "/venv")
        if not os.access(venv + "/bin/python", os.X_OK):
            pi.run("python3", "-m", "venv", venv)
        pi.run(venv + "/bin/pip", "install", "-q", "--upgrade", "pip")
        pi.run(venv + "/bin/pip", "install", "-q", "requests", "anthropic")
        if not pi.run(venv + "/bin/pip", "install", "-q", "curl_cffi", check=False).returncode == 0:
            say("Note: curl_cffi isn't available for this Pi; using plain requests instead.")

        heading("Settings in %s" % self.CONF)
        pi.makedirs(self.CONF_DIR)
        if not pi.exists(self.CONF):
            pi.write(self.CONF, self.DEFAULT_CONF, 0o640, "root:claude-st")
        allow = "" if s.atari == "any" else "".join(" --allow " + ip for ip in s.atari.replace(",", " ").split())
        self.set_var(pi, "CLAUDE_ST_ARGS", "--backend %s --tcp 0.0.0.0:%s%s" % (s.backend, s.tcp_port, allow))
        if pi.have("ufw") and "Status: active" in pi.out("ufw", "status"):
            who = HOME_NETS if s.atari == "any" else s.atari.replace(",", " ").split()
            firewall(pi, [s.tcp_port], list(who))
            say("Firewall (ufw): allowed %s to port %s" % (s.atari, s.tcp_port))

        if s.backend == "claudeai" and not self.get_var(pi, "CLAUDE_SESSION_KEY"):
            say("claude.ai needs your browser's sessionKey cookie (ClaudeST's README says where to find it).")
            key = pi.ask("Paste it now, or press Return to add it later with: sudo %s set-key: " % PROG, secret=True)
            if key:
                self.set_var(pi, "CLAUDE_SESSION_KEY", key)
        if s.backend == "api" and not self.get_var(pi, "ANTHROPIC_API_KEY"):
            key = pi.ask("Anthropic API key (input hidden): ", secret=True)
            if key:
                self.set_var(pi, "ANTHROPIC_API_KEY", key)

        heading("Installing the service")
        pi.copy(unit, self.unit_file(), 0o644)
        pi.run("systemctl", "daemon-reload")
        pi.run("systemctl", "enable", "claude-st", out="hide")
        pi.run("systemctl", "restart", "claude-st")

        heading("Done")
        say("Backend: %s   network: listening on port %s for the Atari at %s" % (s.backend, s.tcp_port, s.atari),
            "In ClaudeST on the Atari, Options > Settings > Network:  %s, port %s" % (pi.ip() or "GATEWAY_IP",
                                                                                     s.tcp_port))
        say("Status:  systemctl status claude-st", "Log:     journalctl -u claude-st -f")

    def set_key(self, pi):
        if not pi.exists(self.CONF):
            raise Failed("Not installed yet: install claude first.")
        key = pi.ask("Paste the claude.ai sessionKey (input hidden): ", secret=True)
        if not key:
            raise Failed("No key given, nothing changed.")
        self.set_var(pi, "CLAUDE_SESSION_KEY", key)
        pi.run("systemctl", "restart", "claude-st")
        say("Key updated and claude-st restarted.")

    def remove(self, pi):
        heading("Removing ClaudeST")
        pi.run("systemctl", "disable", "--now", "claude-st", check=False, out="hide", errors=False)
        pi.remove(self.unit_file())
        pi.run("systemctl", "daemon-reload")
        pi.rmtree(self.PREFIX)
        say("Kept %s and /var/lib/claude-st (your settings and API-mode history)." % self.CONF_DIR,
            "Delete them by hand if you don't need them; the claude-st user is left too.")

    def describe(self, pi):
        args = self.get_var(pi, "CLAUDE_ST_ARGS") if os.access(pi.path(self.CONF), os.R_OK) else ""
        what = (pi.read(self.PREFIX + "/SOURCE") or "").strip()
        return "; ".join(x for x in (args, what) if x)


CLAUDE = Claude()
SERVICES = {g.key: g for g in GATEWAYS + [CLAUDE]}
NAMES = {"email": "mail", "emailgate": "mail", "cal": "dav", "ecal": "dav", "econtact": "dav",
         "contacts": "dav", "ecalgate": "dav", "eftp": "ftp", "eftpgate": "ftp",
         "claudest": "claude", "claude-st": "claude", "eweb": "web", "webgate": "web",
         "epdf": "pdf", "econvert": "pdf", "pdfgate": "pdf",
         "translation": "translate", "translategate": "translate",
         "eplay": "radio", "radiogate": "radio", "dashboard": "dash", "dashgate": "dash"}


def service(name):
    key = NAMES.get(name.lower(), name.lower())
    if key not in SERVICES:
        raise Usage("%s: there is no such service; there are %s" % (name, ", ".join(SERVICES)))
    return SERVICES[key]


# ---------------------------------------------------------------- the commands

def status(pi, src=HERE):
    say("AERA gateways on this computer (%s, this copy: AERA-Gateway %s in %s)" % (pi.ip() or "no address",
                                                                             VERSION, src))
    stale = False
    for svc in GATEWAYS + [CLAUDE]:
        if not svc.installed(pi):
            say("  %-9s %-13s not installed" % (svc.key, svc.name))
            continue
        state = pi.out("systemctl", "is-active", svc.name).strip() or "stopped"
        if svc is CLAUDE:
            say("  %-9s %-13s %-9s %s" % (svc.key, svc.name, state, svc.describe(pi)))
            continue
        try:
            ns, _, script = svc.current(pi, src)
        except Failed as e:
            say("  %-9s %-13s %-9s %s" % (svc.key, svc.name, state, e))
            continue
        ports = " ".join("%s%s" % (p, "" if listening(pi, p) else " (not listening)") for p in svc.ports(ns))
        who = "only " + ", ".join(ns.allow) if ns.allow else "home network"
        say("  %-9s %-13s %-9s port %s; %s; %s" % (svc.key, svc.name, state, ports, who, svc.describe(ns)))
        if os.path.dirname(script) != OPT:
            say("                          set up by the app's own install.sh: sudo %s update takes it over" % PROG)
            stale = True
    if any(svc.installed(pi) for svc in GATEWAYS) and not stale:
        differ = [f for f in FILES if pi.read("%s/%s" % (OPT, f)) != open(os.path.join(src, f)).read()]
        if differ:
            say("This copy's %s differ from the ones running: sudo %s update" % (", ".join(differ), PROG))
    if pi.exists(Mail.STUNNEL):
        say("EMail 1.x's stunnel set-up is still there: sudo %s install mail replaces it, with its servers "
            "and ports" % PROG)


def update(pi, o, src=HERE):
    todo = [g for g in GATEWAYS if g.installed(pi)]
    if not todo and not CLAUDE.installed(pi):
        say("No AERA gateway is installed on this computer: nothing to update.")
        return
    for g in todo:
        heading("Updating %s (%s)" % (g.key, g.name))
        install_gateway(pi, g, settings_for(g, []), src)
    if CLAUDE.on_cable(pi):
        # (its bridge left as it is, on its cable: it goes on with the ClaudeST
        # before 2.3; said on the output, so a script's update shows it too)
        heading("claude (claude-st): left as it is")
        say(Claude.SERIAL_GONE % VERSION)
    elif CLAUDE.installed(pi):
        heading("Updating claude (claude-st)")
        args = ["--from", o.source] if o.source else []
        CLAUDE.install(pi, settings_for(CLAUDE, args))


def install_all(pi, o, src=HERE):
    """every service, one after the other, for the Atari at o.allow; one
    that fails doesn't stop the others. Those already installed keep their
    settings (--allow, if given, is the one change)."""
    allow = ",".join(o.allow) if o.allow else None
    done, failed, skipped = [], [], []
    for svc in GATEWAYS + [CLAUDE]:
        if svc is MAIL and not o.mail and not svc.installed(pi) and not pi.exists(Mail.STUNNEL):
            skipped.append("mail (name your provider's servers: --mail IMAP SMTP[:587] [POP3])")
            continue
        if svc.key == "pdf" and not os.path.isdir(os.path.join(Pdf.PDF_SRC, "epdf")):
            skipped.append("pdf (EPDF's converter comes only with AERA-Gateway itself, not an app's copy)")
            continue
        if svc.key == "translate" and not svc.installed(pi) and not svc.arch_ok(pi):
            skipped.append("translate (its engine needs the 64-bit Raspberry Pi OS: uname -m says %s)"
                           % svc.arch(pi))
            continue
        if svc.key == "translate" and not svc.installed(pi) and not svc.memory_ok(pi):
            skipped.append("translate (its engine needs a Pi with 4 GB of memory or more; this one has %d MB)"
                           % svc.memory(pi))
            continue
        if svc is CLAUDE:
            argv = ["--from", o.source] if o.source else []
            if CLAUDE.on_cable(pi):
                skipped.append("claude (left on its serial cable: %s)" % (Claude.SERIAL_GONE % VERSION))
                continue
            if allow or not svc.installed(pi):
                argv += ["--network", "--atari", allow or "any"]
        else:
            argv = (o.mail or []) if svc is MAIL else []
            argv += ["--allow", allow] if allow and svc is not DASH else []    # (the Mac or PC isn't an Atari)
            argv += ["--browser"] if svc.key == "web" and o.browser else []
        heading("%s (%s)" % (svc.key, svc.name))
        try:
            if svc is CLAUDE:
                CLAUDE.install(pi, settings_for(svc, argv))
            else:
                install_gateway(pi, svc, settings_for(svc, argv), src)
            done.append(svc.key)
        except Failed as e:
            print(e, file=sys.stderr)
            failed.append(svc.key)
    heading("All")
    say("Installed: %s" % (", ".join(done) or "none"))
    if skipped:
        say("Not installed: " + "; ".join(skipped))
    if failed:
        raise Failed("Didn't install: %s (see above); the others run." % ", ".join(failed))


def settings_for(svc, argv):
    ap = argparse.ArgumentParser(prog="aera-gateway install " + svc.key)
    svc.options(ap)
    return ap.parse_args(argv)


def main(argv=None, pi=None):
    argv = sys.argv[1:] if argv is None else argv
    pi = pi or Pi()
    if not argv or argv[0] in ("-h", "--help", "help"):
        say(__doc__.strip())
        return 0 if argv else 2
    cmd, rest = argv[0], argv[1:]
    try:
        if cmd == "status":
            status(pi)
            return 0
        if cmd not in ("install", "update", "remove", "set-key"):
            raise Usage("%s: the commands are install, update, status, remove and set-key" % cmd)
        if cmd == "install" and rest[:1] == ["all"]:
            ap = argparse.ArgumentParser(prog="aera-gateway install all",
                                         description="every service, for one Atari")
            ap.add_argument("--allow", action="append", metavar="ATARI_IP",
                            help="the Atari that may use them (more: IP1,IP2); claude's --atari too")
            ap.add_argument("--mail", nargs="+", metavar="SERVER",
                            help="IMAP_SERVER SMTP_SERVER[:587] [POP3_SERVER]: without them, mail is left out")
            ap.add_argument("--browser", action="store_true", help="web with the Gateway's browser (a Pi with 2 GB)")
            ap.add_argument("--from", dest="source", metavar="DIR",
                            help="ClaudeST's bridge from this ClaudeST copy (default: this AERA-Gateway's own)")
            o = ap.parse_args(rest[1:])
            if o.mail and len(o.mail) not in (2, 3):
                raise Usage("--mail IMAP_SERVER SMTP_SERVER[:587] [POP3_SERVER]")
            if not pi.is_root():
                raise Failed("Please run with sudo.")
            install_all(pi, o)
            return 0
        if cmd == "update":
            ap = argparse.ArgumentParser(prog="aera-gateway update")
            ap.add_argument("--from", dest="source", metavar="DIR",
                            help="ClaudeST's bridge from this ClaudeST copy (default: this AERA-Gateway's own)")
            o = ap.parse_args(rest)
        elif cmd == "set-key":
            if rest:
                raise Usage("sudo aera-gateway set-key: it asks for the new claude.ai session key; "
                            "it takes nothing more")
            o = None
        else:
            if not rest or rest[0].startswith("-"):
                raise Usage("aera-gateway %s SERVICE: one of %s" % (cmd, ", ".join(SERVICES)))
            svc = service(rest[0])
            o = settings_for(svc, rest[1:]) if cmd == "install" else None
            if cmd == "remove" and rest[1:]:
                raise Usage("aera-gateway remove %s takes nothing more" % svc.key)
        if not pi.is_root():
            raise Failed("Please run with sudo.")
        if cmd == "update":
            update(pi, o)
        elif cmd == "set-key":
            CLAUDE.set_key(pi)
        elif svc is CLAUDE:
            CLAUDE.remove(pi) if cmd == "remove" else CLAUDE.install(pi, o)
        elif cmd == "remove" or o.remove:
            remove_gateway(pi, svc)
        else:
            install_gateway(pi, svc, o)
        return 0
    except Usage as e:
        print("aera-gateway: %s" % e, file=sys.stderr)
        return 2
    except Failed as e:
        print(e, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
